# Non-secret local adapter configuration. npm run dev explicitly enables synthetic demo mode.
TROVE_ORIGIN=http://localhost:5173
TROVE_DB_PATH=.data/trove.sqlite
PORT=3001
# For non-demo OIDC use a separate database and an HTTPS reverse proxy.
# Supply Entra registration values securely; never commit a client secret.
# TROVE_ENTRA_TENANT_ID=
# TROVE_ENTRA_CLIENT_ID=
# TROVE_ENTRA_CLIENT_SECRET=
# TROVE_ENTRA_REDIRECT_URI=https://your-app.example/auth/callback
