{
  "name": "trove-relationship-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env.local server/dev.ts",
    "dev:web": "vite",
    "dev:fabric": "rayfin dev",
    "build": "npm run typecheck && vite build",
    "build:fabric": "node -e \"console.error('Fabric API adapter is not deployed. See docs/fabric-integration.md.'); process.exit(1)\"",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "format:check": "prettier --check src server shared tests e2e rayfin/data",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@microsoft/rayfin-auth-provider-fabric": "^1.36.2",
    "@microsoft/rayfin-client": "^1.36.2",
    "@microsoft/rayfin-core": "^1.36.2",
    "express": "^5.3.0",
    "lucide-react": "^1.57.0",
    "openid-client": "^6.8.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/rayfin-cli": "^1.36.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/dagre": "^0.7.54",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
